# 2026-09-11 FIX — was lone `*` from `python -m venv ~` (venv template writes * to ignore itself).
# That nuked the home git repo: feature/ribbon-animation couldn't add ANY file.
# Fix: ignore-everything AT ROOT then allowlist only the ship tree.
# Home = 70G of noise; only src/tools + manifests should ever commit here.

# — block everything at root —
/*
/.*

# — allowlist: the only paths this repo tracks —
!/src
!/src/**
!/tools
!/tools/**
!/templates
!/templates/**
!/tests
!/tests/**
!/docs
!/docs/**
!/projects
!/projects/**
!/rag_storage
!/rag_storage/**
!/scripts
!/scripts/**
!/.gitignore
!/package.json
!/package-lock.json
!/README.md
!/AGENTS.md

# — nested repositories —
# Their own .git, deliberately not tracked by this one: recording them would
# create a gitlink no clone could resolve. See docs/PROJECT_MAP.md.
projects/lean/

# — ephemeral everywhere (even inside src/tools) —
__pycache__/
*.pyc
*.pyo
.venv/
venv/
node_modules/
.DS_Store
*.log
# *.bak is noise by default. The one deliberate exception is syntaxbuff.py.bak:
# its content exists in no committed blob, and it differs from the tracked file, so
# leaving it ignored meant the only copy lived in one working tree. Versioned so a
# lost checkout is recoverable.
*.bak
!tools/inference/syntaxbuff.py.bak
# MOLT: keep RAG sidecars + instar state, ignore raw audits & gamed telemetry
rag_storage/governor_audit.jsonl
rag_storage/*.tmp
# StateSnapshotter output from named smoke runs is runtime state, not the sidecar
# or instar data this allowlist exists for.
rag_storage/molt_state/
.pytest_cache/
.coverage
coverage.xml

# — venv / dot-noise already covered by /* and /.* —
# explicit keeps for clarity if someone reads this file:
.env.vault
screenshots_scan/

# guard snapshots are ephemeral (SHA-256 chain lives in guard.jsonl, tar is local)
tools/guard/snapshots/
tools/guard/guard.jsonl

# — additional large/temporary artifacts to keep the indexer fast —
.cache/
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z
*.tmp
*.temp
