{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arena Logic Gladiator Sidecar",
  "type": "object",
  "required": [
    "skill",
    "version",
    "hydrated_at",
    "feeds"
  ],
  "properties": {
    "skill": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "hydrated_at": {
      "type": "string",
      "format": "date-time"
    },
    "oomf_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "feeds": {
      "type": "object"
    },
    "entitlements": {
      "type": "object"
    }
  }
}