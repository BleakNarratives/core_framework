      ],
      "status": "active",
      "last_update": "2026-06-23T23:14:35.996709Z"
    }
  ],
  "tasks": [],
  "communication_protocol": {
    "file_based": {
      "path": "foxwood_comms.json",
      "update_frequency": "continuous",
      "conflict_resolution": "last_write_wins",
      "backup_location": "foxwood_backup"
    },
    "agent_responsibilities": {
      "read": [
        "all"
      ],
      "write": [
        "assigned_tasks",
        "status_updates",
        "task_completion"
      ],
      "coordinate": [
        "vibe"
      ]
    }
  },
  "automation_rules": {
    "task_assignment": {
      "strategy": "capability_based",
      "fallback": "round_robin"
    },
    "priority_handling": {
      "critical": "immediate_execution",
      "high": "next_available_agent",
      "medium": "queue_based",
      "low": "background_processing"
    },
    "error_handling": {
      "max_retries": 3,
      "escalation_path": [
        "syntax",
        "vibe",
        "gemini"
      ],
      "timeout": "300s"
    }
  },
  "performance_metrics": {
    "tracked": [
      "task_completion_time",
      "agent_response_time",
      "error_rate",
      "resource_utilization"
    ],
    "reporting_frequency": "real_time",
    "storage": "foxwood_metrics.json"
  }
}